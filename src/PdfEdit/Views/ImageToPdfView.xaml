<UserControl x:Class="PdfEdit.Views.ImageToPdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:PdfEdit.Behaviors"
             xmlns:viewModels="clr-namespace:PdfEdit.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1080" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=viewModels:ImageToPdfViewModel}">

    <UserControl.Resources>

        <!-- One image = one page of the output PDF. -->
        <DataTemplate x:Key="ImageCardTemplate" DataType="{x:Type viewModels:ImageItemViewModel}">
            <Grid x:Name="Root" ToolTip="{Binding FilePath}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="Card"
                        Grid.Row="0"
                        Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Multiply}, ConverterParameter=1.0}"
                        Background="{DynamicResource ThumbnailBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Effect="{DynamicResource CardShadowEffect}"
                        RenderTransformOrigin="0.5,0.5"
                        ClipToBounds="True">

                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>

                    <Grid>
                        <Image Source="{Binding Thumbnail}" Margin="6" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Text="Loading…" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE783;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="26" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="11"
                                       TextAlignment="Center" Margin="0,6,0,0"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </StackPanel>

                        <Border x:Name="Scrim" Background="{DynamicResource ScrimBrush}"
                                Opacity="0" IsHitTestVisible="False" />

                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                Padding="10,3"
                                CornerRadius="{DynamicResource PillCornerRadius}"
                                Background="#B3000000">
                            <TextBlock Text="{Binding PageNumber}" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold" />
                        </Border>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                Padding="8,3"
                                CornerRadius="{DynamicResource PillCornerRadius}"
                                Background="#B3000000"
                                Visibility="{Binding DimensionsText, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding DimensionsText}" Foreground="White" FontSize="11" />
                        </Border>

                        <Button x:Name="RemoveButton"
                                Style="{DynamicResource ThumbnailDangerActionButtonStyle}"
                                Content="&#xE74D;"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Opacity="0"
                                ToolTip="Remove this image"
                                Command="{Binding RemoveCommand}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding FileName}"
                           Style="{DynamicResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </Grid>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Effect" Value="{DynamicResource HoverShadowEffect}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Scrim" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="RemoveButton" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1.04" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1.04" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Scrim" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="RemoveButton" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>

                <DataTrigger Value="True"
                             Binding="{Binding (behaviors:DragDropReorder.IsDraggedItem), RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                    <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ImageCardContainerStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource PageThumbnailItemStyle}">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>

        <Style x:Key="ActiveDropZoneStyle" TargetType="Border"
               BasedOn="{StaticResource DropZoneBorderStyle}">
            <Style.Triggers>
                <Trigger Property="behaviors:FileDrop.IsDragOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleTextStyle}" />
                <TextBlock Text="{Binding Description}" Style="{DynamicResource SubtitleTextStyle}"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- Command bar -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="10,8" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{DynamicResource AccentButtonStyle}" Margin="0,2,8,2"
                            Command="{Binding AddImagesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Add images" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{DynamicResource IconButtonStyle}" Content="&#xE74D;" Margin="0,2,8,2"
                            ToolTip="Remove selected images" Command="{Binding RemoveSelectedCommand}" />

                    <Button Style="{DynamicResource SubtleButtonStyle}" Content="Sort by name" Margin="0,2,4,2"
                            Command="{Binding SortByNameCommand}" />

                    <Button Style="{DynamicResource SubtleButtonStyle}" Content="Clear" Margin="0,2,4,2"
                            Command="{Binding ClearCommand}" />
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource IconButtonStyle}" Content="&#xE71F;"
                            ToolTip="Smaller thumbnails" Command="{Binding ZoomOutCommand}" />
                    <Button Style="{DynamicResource IconButtonStyle}" Content="&#xE8A3;" Margin="2,0,10,0"
                            ToolTip="Larger thumbnails" Command="{Binding ZoomInCommand}" />

                    <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding CreatePdfCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Create PDF…" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace: gallery + options -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Border Style="{StaticResource ActiveDropZoneStyle}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="440"
                        behaviors:FileDrop.Command="{Binding DropFilesCommand}"
                        behaviors:FileDrop.Extensions=".jpg,.jpeg,.png,.bmp,.gif,.webp,.tif,.tiff"
                        Visibility="{Binding Images.Count, Converter={StaticResource CountToVisibilityInverted}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE91B;" FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="Drop images here" Style="{DynamicResource SectionHeaderTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="JPG, PNG, BMP, GIF, WEBP and TIFF. Each image becomes one page."
                                   Style="{DynamicResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360" Margin="0,4,0,0" />
                        <Button Style="{DynamicResource AccentButtonStyle}" Content="Browse…"
                                HorizontalAlignment="Center" Margin="0,18,0,0"
                                Command="{Binding AddImagesCommand}" />
                    </StackPanel>
                </Border>

                <ListBox Style="{DynamicResource PageThumbnailListBoxStyle}"
                         ItemContainerStyle="{StaticResource ImageCardContainerStyle}"
                         ItemTemplate="{StaticResource ImageCardTemplate}"
                         ItemsSource="{Binding Images}"
                         SelectionMode="Extended"
                         behaviors:DragDropReorder.IsEnabled="True"
                         behaviors:FileDrop.Command="{Binding DropFilesCommand}"
                         behaviors:FileDrop.Extensions=".jpg,.jpeg,.png,.bmp,.gif,.webp,.tif,.tiff"
                         Visibility="{Binding Images.Count, Converter={StaticResource CountToVisibility}}">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </Grid>

            <!-- Options -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}"
                    Width="286" Padding="20" Margin="20,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Page setup" Style="{DynamicResource SectionHeaderTextStyle}" />

                    <TextBlock Text="Page size" Style="{DynamicResource CaptionTextStyle}" Margin="0,16,0,6" />

                    <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="PageSize"
                                 Content="Fit page to image" Margin="0,0,0,6"
                                 IsChecked="{Binding PageSizeMode, Converter={StaticResource EnumEquals}, ConverterParameter=FitToImage}" />

                    <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="PageSize"
                                 Content="A4 (210 × 297 mm)" Margin="0,0,0,6"
                                 IsChecked="{Binding PageSizeMode, Converter={StaticResource EnumEquals}, ConverterParameter=A4}" />

                    <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="PageSize"
                                 Content="US Letter (8.5 × 11 in)"
                                 IsChecked="{Binding PageSizeMode, Converter={StaticResource EnumEquals}, ConverterParameter=Letter}" />

                    <StackPanel Margin="0,18,0,0"
                                IsEnabled="{Binding IsFixedPageSize}"
                                Opacity="{Binding IsFixedPageSize, Converter={StaticResource BoolToOpacity}}">
                        <TextBlock Text="Margin (points)" Style="{DynamicResource CaptionTextStyle}" Margin="0,0,0,6" />
                        <TextBox Style="{DynamicResource AppTextBoxStyle}"
                                 Text="{Binding MarginPoints, UpdateSourceTrigger=LostFocus}" />

                        <CheckBox Style="{DynamicResource AppCheckBoxStyle}" Margin="0,14,0,0"
                                  Content="Rotate page for wide images"
                                  IsChecked="{Binding AutoOrientation}" />
                    </StackPanel>

                    <Border Style="{DynamicResource SeparatorLineStyle}" Margin="0,20,0,16" />

                    <TextBlock Text="Image quality" Style="{DynamicResource CaptionTextStyle}" Margin="0,0,0,6" />
                    <ComboBox Style="{DynamicResource AppComboBoxStyle}"
                              ItemContainerStyle="{DynamicResource AppComboBoxItemStyle}"
                              ItemsSource="{Binding SizeLimitOptions}"
                              SelectedItem="{Binding SelectedSizeLimit, Mode=TwoWay}"
                              DisplayMemberPath="Label" />

                    <TextBlock Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Large photos are downscaled before they go into the PDF, which keeps the output small without a visible quality loss." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="3" Margin="0,10,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Drag the images to change the page order"
                       Style="{DynamicResource CaptionTextStyle}" VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                       Style="{DynamicResource CaptionTextStyle}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Busy overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource BusyOverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" Style="{DynamicResource SectionHeaderTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{DynamicResource AppProgressBarStyle}" Margin="0,16,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    <Button Content="Cancel" Style="{DynamicResource StandardButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,18,0,0"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
