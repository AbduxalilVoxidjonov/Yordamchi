<Window x:Class="PdfEdit.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:PdfEdit.ViewModels"
        mc:Ignorable="d"
        Title="PdfEdit — PDF page organizer"
        Width="1360" Height="860"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Sidebar ============================ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="24,28,24,16">
                    <Border Width="44" Height="44"
                            CornerRadius="{DynamicResource LargeCornerRadius}"
                            Background="{DynamicResource AccentBrush}"
                            Effect="{DynamicResource CardShadowEffect}">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding ApplicationTitle}"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,14,0,0" />

                    <TextBlock Text="Organize, merge and build PDFs"
                               Style="{DynamicResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1"
                         Margin="14,10,14,10"
                         Style="{DynamicResource NavigationListBoxStyle}"
                         ItemContainerStyle="{DynamicResource NavigationItemStyle}"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:NavigationItemViewModel}">
                            <Grid Margin="14,0,10,0" Background="Transparent"
                                  ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="17"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer: theme switch -->
                <StackPanel Grid.Row="2" Margin="24,8,24,22">
                    <Border Style="{DynamicResource SeparatorLineStyle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE708;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="Dark mode"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />

                        <ToggleButton Grid.Column="2"
                                      Style="{DynamicResource AppToggleSwitchStyle}"
                                      IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                      ToolTip="Switch between light and dark theme"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Button Content="Follow system theme"
                            Style="{DynamicResource SubtleButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="-12,6,0,0"
                            Command="{Binding UseSystemThemeCommand}" />

                    <TextBlock Text="{Binding VersionText}"
                               Style="{DynamicResource CaptionTextStyle}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Workspace ============================ -->
        <Border Grid.Column="1"
                Background="{DynamicResource ContentBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="10,0,0,0">
            <ContentControl Content="{Binding CurrentViewModel}"
                            Focusable="False" />
        </Border>
    </Grid>
</Window>
