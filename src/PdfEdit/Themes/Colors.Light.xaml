<!--
    Colors.Light.xaml - Windows 11 Fluent LIGHT palette. Colors + brushes ONLY (no styles).
    Must expose exactly the same x:Key set as Colors.Dark.xaml: ThemeService hot-swaps
    Application.Current.Resources.MergedDictionaries[0] between the two at runtime.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Raw colors ===== -->
    <Color x:Key="ShadowColor">#FF000000</Color>
    <Color x:Key="AccentColor">#FF0067C0</Color>
    <Color x:Key="AppBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="LayerFillColor">#FFFFFFFF</Color>

    <!-- ===== Surfaces ===== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="LayerFillBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayerFillAltBrush" Color="#FFF6F6F6" />

    <!-- ===== Strokes / dividers (alpha-composited so cards read correctly over Mica) ===== -->
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14000000" />
    <SolidColorBrush x:Key="StrokeDefaultBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#72000000" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C000000" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />

    <!-- ===== Accent ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1975C5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF005BA1" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A0067C0" />

    <!-- ===== Control fills ===== -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#1A000000" />

    <!-- ===== Subtle (transparent-until-hover) fills ===== -->
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#14000000" />

    <!-- ===== Semantic ===== -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFD13438" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFA32217" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF0F7B0F" />

    <!-- ===== Page thumbnails / drag &amp; drop ===== -->
    <!-- ThumbnailBackgroundBrush stays near-white in BOTH themes: PDF pages are white paper. -->
    <SolidColorBrush x:Key="ThumbnailBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SelectionStrokeBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="InsertionIndicatorBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="DropZoneStrokeBrush" Color="#4D000000" />
    <SolidColorBrush x:Key="DropZoneFillBrush" Color="#08000000" />

    <!-- ===== Scrollbars ===== -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#59000000" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#8C000000" />

    <!-- ===== Overlays ===== -->
    <!-- ~70% of the window background. -->
    <SolidColorBrush x:Key="BusyOverlayBrush" Color="#B3F3F3F3" />
    <!-- Hover scrim over a page thumbnail; identical in both themes (it sits on the image). -->
    <LinearGradientBrush x:Key="ScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0.0" Color="#00000000" />
        <GradientStop Offset="0.45" Color="#26000000" />
        <GradientStop Offset="1.0" Color="#99000000" />
    </LinearGradientBrush>

</ResourceDictionary>
