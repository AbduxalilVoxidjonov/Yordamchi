<UserControl x:Class="Yordamchi.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Yordamchi.Behaviors"
             xmlns:converters="clr-namespace:Yordamchi.Converters"
             xmlns:viewModels="clr-namespace:Yordamchi.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="820"
             d:DataContext="{d:DesignInstance Type=viewModels:ArchiveViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:EnumEqualsConverter x:Key="ArcEnumEquals" />
            <converters:EnumEqualsToVisibilityConverter x:Key="ArcEnumVisible" />

            <Style x:Key="ArcLabelStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="ArcHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,12" />
            </Style>

            <!-- Fayl sudralib kelganda accent fon -->
            <Style x:Key="ArcDropZoneStyle" TargetType="Border"
                   BasedOn="{StaticResource DropZoneBorderStyle}">
                <Style.Triggers>
                    <Trigger Property="behaviors:FileDrop.IsDragOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ==================== Arxivlanadigan manba qatori ==================== -->
            <DataTemplate x:Key="ArcSourceRowTemplate" DataType="{x:Type viewModels:ArchiveSourceViewModel}">
                <Border Background="Transparent" Padding="12,9" Margin="0,0,0,4"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Glyph}"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" />

                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DetailsText}"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding SizeBytes, Converter={StaticResource FileSize}}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <Button Grid.Column="3"
                                Style="{DynamicResource IconButtonStyle}"
                                Content="&#xE711;"
                                FontFamily="{DynamicResource IconFontFamily}"
                                ToolTip="Ro'yxatdan olib tashlash"
                                VerticalAlignment="Center"
                                Command="{Binding RemoveCommand}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- ==================== Arxiv ichidagi yozuv qatori ==================== -->
            <DataTemplate x:Key="ArcEntryRowTemplate" DataType="{x:Type viewModels:ArchiveEntryViewModel}">
                <Border Background="Transparent" Padding="12,8" Margin="0,0,0,2"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Style="{DynamicResource AppCheckBoxStyle}"
                                  IsChecked="{Binding IsSelected}"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FolderPath}"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding FolderPath, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="&#xE72E;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   ToolTip="Bu yozuv parol bilan shifrlangan"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding ModifiedText}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />

                        <TextBlock Grid.Column="4"
                                   Text="{Binding SizeBytes, Converter={StaticResource FileSize}}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   VerticalAlignment="Center"
                                   MinWidth="66"
                                   TextAlignment="Right" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Sarlavha va rejim ============================ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleTextStyle}" />
            <TextBlock Text="{Binding Description}" Style="{DynamicResource SubtitleTextStyle}" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="ArchiveMode"
                             Content="Arxivlash"
                             Command="{Binding ShowCreateCommand}"
                             IsChecked="{Binding Mode, Converter={StaticResource ArcEnumEquals}, ConverterParameter=Create}" />

                <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="ArchiveMode"
                             Content="Arxivdan ochish"
                             Margin="26,0,0,0"
                             Command="{Binding ShowExtractCommand}"
                             IsChecked="{Binding Mode, Converter={StaticResource ArcEnumEquals}, ConverterParameter=Extract}" />
            </StackPanel>
        </StackPanel>

        <!-- ============================ 1-rejim: arxivlash ============================ -->
        <Grid Grid.Row="1" Margin="0,18,0,0"
              Visibility="{Binding Mode, Converter={StaticResource ArcEnumVisible}, ConverterParameter=Create}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="352" />
            </Grid.ColumnDefinitions>

            <!-- Manbalar ro'yxati -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Arxivga qo'shiladiganlar"
                                   Style="{DynamicResource SectionHeaderTextStyle}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{DynamicResource StandardButtonStyle}" Content="Fayl qo'shish"
                                    Command="{Binding AddFilesCommand}" />
                            <Button Style="{DynamicResource StandardButtonStyle}" Content="Papka qo'shish"
                                    Margin="8,0,0,0"
                                    Command="{Binding AddFolderCommand}" />
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="Tozalash"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearSourcesCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Bo'sh holat: katta tashlash hududi -->
                    <Border Grid.Row="1"
                            Style="{StaticResource ArcDropZoneStyle}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            MinWidth="440"
                            behaviors:FileDrop.Command="{Binding DropSourcesCommand}"
                            behaviors:FileDrop.IncludeFolders="True"
                            Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibilityInverted}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xF12B;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="44" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="Fayl va papkalarni shu yerga tashlang"
                                       Style="{DynamicResource SectionHeaderTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="Yoki yuqoridagi tugmalar orqali tanlang. Papkalar ichidagi barcha fayllar bilan qo'shiladi."
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="380" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Style="{DynamicResource AppScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Sources}"
                                      ItemTemplate="{StaticResource ArcSourceRowTemplate}"
                                      behaviors:FileDrop.Command="{Binding DropSourcesCommand}"
                                      behaviors:FileDrop.IncludeFolders="True" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="{Binding SourcesSummary}"
                               Style="{DynamicResource CaptionTextStyle}"
                               Margin="0,12,0,0" />
                </Grid>
            </Border>

            <!-- Sozlamalar -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="20" Margin="16,0,0,0">
                <ScrollViewer Style="{DynamicResource AppScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Siqish darajasi" Style="{StaticResource ArcLabelStyle}" />

                        <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="ArcLevel"
                                     Content="Siqishsiz — eng tez"
                                     IsChecked="{Binding CompressionLevel, Converter={StaticResource ArcEnumEquals}, ConverterParameter=Store}" />
                        <TextBlock Text="Video, rasm va Office fayllari allaqachon siqilgan — ular uchun shu ma'quli."
                                   Style="{StaticResource ArcHintStyle}" />

                        <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="ArcLevel"
                                     Content="Tez"
                                     IsChecked="{Binding CompressionLevel, Converter={StaticResource ArcEnumEquals}, ConverterParameter=Fast}" />

                        <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="ArcLevel"
                                     Content="Oddiy"
                                     IsChecked="{Binding CompressionLevel, Converter={StaticResource ArcEnumEquals}, ConverterParameter=Normal}" />

                        <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="ArcLevel"
                                     Content="Maksimal — eng kichik hajm"
                                     IsChecked="{Binding CompressionLevel, Converter={StaticResource ArcEnumEquals}, ConverterParameter=Maximum}" />
                        <TextBlock Text="Matnli hujjatlarda sezilarli yutuq beradi, lekin sekinroq ishlaydi."
                                   Style="{StaticResource ArcHintStyle}" />

                        <Border Style="{DynamicResource SeparatorLineStyle}" Margin="0,6,0,16" />

                        <CheckBox Style="{DynamicResource AppCheckBoxStyle}"
                                  Content="Papkalar tuzilishi saqlansin"
                                  IsChecked="{Binding KeepFolderStructure}" />
                        <TextBlock Text="O'chirilsa barcha fayllar arxiv ildiziga tekis yoziladi."
                                   Style="{StaticResource ArcHintStyle}" />

                        <Border Style="{DynamicResource SeparatorLineStyle}" Margin="0,6,0,16" />

                        <CheckBox Style="{DynamicResource AppCheckBoxStyle}"
                                  Content="Parol bilan himoyalansin"
                                  IsChecked="{Binding UsePassword}" />

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding UsePassword, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Parol" Style="{StaticResource ArcLabelStyle}" />
                            <TextBox Style="{DynamicResource AppTextBoxStyle}"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Parolni takrorlang" Style="{StaticResource ArcLabelStyle}" Margin="0,12,0,6" />
                            <TextBox Style="{DynamicResource AppTextBoxStyle}"
                                     Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Shifrlash usuli" Style="{StaticResource ArcLabelStyle}" Margin="0,16,0,6" />

                            <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="ArcEncryption"
                                         Content="AES-256 — kuchli"
                                         IsChecked="{Binding Encryption, Converter={StaticResource ArcEnumEquals}, ConverterParameter=Aes256}" />

                            <RadioButton Style="{DynamicResource AppRadioButtonStyle}" GroupName="ArcEncryption"
                                         Content="ZipCrypto — hamma joyda ochiladi"
                                         Margin="0,6,0,0"
                                         IsChecked="{Binding Encryption, Converter={StaticResource ArcEnumEquals}, ConverterParameter=ZipCrypto}" />

                            <TextBlock Text="{Binding PasswordHint}"
                                       Style="{StaticResource ArcHintStyle}"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================ 2-rejim: arxivdan ochish ============================ -->
        <Grid Grid.Row="1" Margin="0,18,0,0"
              Visibility="{Binding Mode, Converter={StaticResource ArcEnumVisible}, ConverterParameter=Extract}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="352" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ArchiveName}"
                                       Style="{DynamicResource SectionHeaderTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Arxiv ichidagilar"
                                       Style="{DynamicResource SectionHeaderTextStyle}"
                                       Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibilityInverted}}" />
                            <TextBlock Text="{Binding ArchiveSummary}"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{DynamicResource StandardButtonStyle}" Content="Arxivni tanlash"
                                    Command="{Binding OpenArchiveCommand}" />
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="Hammasi"
                                    Margin="8,0,0,0"
                                    Command="{Binding SelectAllEntriesCommand}" />
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="Hech biri"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearEntrySelectionCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Bo'sh holat -->
                    <Border Grid.Row="1"
                            Style="{StaticResource ArcDropZoneStyle}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            MinWidth="440"
                            behaviors:FileDrop.Command="{Binding DropArchiveCommand}"
                            Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityInverted}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="44" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="Arxivni shu yerga tashlang"
                                       Style="{DynamicResource SectionHeaderTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="ZIP, RAR, 7z, TAR va GZip ochiladi. Parolli arxiv uchun o'ngdagi maydonga parolni kiriting."
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="380" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Style="{DynamicResource AppScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Entries}"
                                      ItemTemplate="{StaticResource ArcEntryRowTemplate}"
                                      behaviors:FileDrop.Command="{Binding DropArchiveCommand}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Minglab yozuvli arxivlarda ro'yxat virtualizatsiya bilan chiziladi. -->
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="{Binding SelectionSummary}"
                               Style="{DynamicResource CaptionTextStyle}"
                               Margin="0,12,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="20" Margin="16,0,0,0">
                <ScrollViewer Style="{DynamicResource AppScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Chiqariladigan papka" Style="{StaticResource ArcLabelStyle}" />

                        <TextBox Style="{DynamicResource AppTextBoxStyle}"
                                 Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" />

                        <Button Style="{DynamicResource StandardButtonStyle}"
                                Content="Papkani tanlash…"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Command="{Binding PickTargetFolderCommand}" />

                        <TextBlock Text="Papka yo'q bo'lsa avtomatik yaratiladi."
                                   Style="{StaticResource ArcHintStyle}" />

                        <Border Style="{DynamicResource SeparatorLineStyle}" Margin="0,6,0,16" />

                        <TextBlock Text="Parol" Style="{StaticResource ArcLabelStyle}" />
                        <TextBox Style="{DynamicResource AppTextBoxStyle}"
                                 Text="{Binding ExtractPassword, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Style="{DynamicResource StandardButtonStyle}"
                                Content="Ro'yxatni qayta o'qish"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Command="{Binding ReloadCommand}" />

                        <TextBlock Style="{StaticResource ArcHintStyle}"
                                   Text="Bu arxiv parol bilan himoyalangan — parolni kiriting va ro'yxatni qayta o'qing."
                                   Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Style="{StaticResource ArcHintStyle}"
                                   Text="Arxiv parolsiz bo'lsa bu maydonni bo'sh qoldiring."
                                   Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVisibilityInverted}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================ Pastki panel ============================ -->
        <Border Grid.Row="2"
                Style="{DynamicResource CardBorderStyle}"
                Padding="16,12"
                Margin="0,14,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{DynamicResource StandardButtonStyle}"
                            Content="Papkada ko'rsatish"
                            Margin="0,0,10,0"
                            Command="{Binding RevealResultCommand}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />

                    <Button Style="{DynamicResource AccentButtonStyle}"
                            MinWidth="170"
                            Command="{Binding CreateCommand}"
                            Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF12B;" FontFamily="{DynamicResource IconFontFamily}" VerticalAlignment="Center" />
                            <TextBlock Text="Arxivlash" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{DynamicResource AccentButtonStyle}"
                            MinWidth="170"
                            Command="{Binding ExtractCommand}"
                            Visibility="{Binding IsExtractMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFontFamily}" VerticalAlignment="Center" />
                            <TextBlock Text="Chiqarish" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Band holati (overlay) ============================ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource BusyOverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" Style="{DynamicResource SectionHeaderTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{DynamicResource AppProgressBarStyle}" Margin="0,16,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    <Button Content="Bekor qilish" Style="{DynamicResource StandardButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,18,0,0"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
