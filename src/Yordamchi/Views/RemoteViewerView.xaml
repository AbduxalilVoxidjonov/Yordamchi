<UserControl x:Class="Yordamchi.Views.RemoteViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Yordamchi.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=viewModels:RemoteViewerViewModel}">

    <UserControl.Resources>
        <!-- Topilgan bitta kompyuter qatori -->
        <DataTemplate x:Key="ComputerRowTemplate" DataType="{x:Type viewModels:DiscoveredComputerViewModel}">
            <Border Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Endpoint}" Style="{DynamicResource CaptionTextStyle}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{DynamicResource StandardButtonStyle}"
                            Content="Ulanish"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.ConnectComputerCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Sarlavha ==================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleTextStyle}" />
            <TextBlock Text="{Binding Description}" Style="{DynamicResource SubtitleTextStyle}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ==================== Asboblar qatori ==================== -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="16,12" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{DynamicResource StandardButtonStyle}"
                        MinWidth="120"
                        Command="{Binding ToggleSearchCommand}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Qidirish" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Text" Value="Qidiruvni to'xtatish" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <TextBox Grid.Column="1"
                         Style="{DynamicResource AppTextBoxStyle}"
                         Width="150"
                         Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         ToolTip="Kompyuter IP manzili"
                         Text="{Binding ManualHost, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Grid.Column="2"
                         Style="{DynamicResource AppTextBoxStyle}"
                         Width="88"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         ToolTip="Port"
                         Text="{Binding ManualPort, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="3"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="Ulanish"
                        Margin="8,0,0,0"
                        Command="{Binding ConnectManualCommand}" />

                <Button Grid.Column="5"
                        Style="{DynamicResource SubtleButtonStyle}"
                        Content="Uzish"
                        Command="{Binding DisconnectCommand}" />
            </Grid>
        </Border>

        <!-- ==================== Ro'yxat + ekran ==================== -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Topilgan kompyuterlar -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Topilgan kompyuterlar"
                               Style="{DynamicResource SectionHeaderTextStyle}"
                               Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="1"
                                  Style="{DynamicResource AppScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock Text="Hali topilmadi. &quot;Qidirish&quot; ni bosing yoki IP manzilni qo'lda kiriting."
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Computers.Count, Converter={StaticResource CountToVisibilityInverted}}" />

                            <ItemsControl ItemsSource="{Binding Computers}"
                                          ItemTemplate="{StaticResource ComputerRowTemplate}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Ekran -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="16,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource LayerFillAltBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <TextBlock Text="Ekran shu yerda ko'rinadi. Kompyuterga ulaning."
                                       Style="{DynamicResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityInverted}}" />

                            <Image Source="{Binding CurrentFrame}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="4" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ConnectionStatus}"
                               Style="{DynamicResource CaptionTextStyle}"
                               Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
