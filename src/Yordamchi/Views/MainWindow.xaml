<Window x:Class="Yordamchi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Yordamchi.ViewModels"
        mc:Ignorable="d"
        Title="Yordamchi — PDF vositalari, arxiv va ekran yozuvi"
        Width="1420" Height="900"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource AppBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Yon panel ============================ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brend -->
                <StackPanel Grid.Row="0" Margin="24,28,24,16">
                    <Border Width="44" Height="44"
                            CornerRadius="{DynamicResource LargeCornerRadius}"
                            Background="{DynamicResource AccentBrush}"
                            Effect="{DynamicResource CardShadowEffect}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding ApplicationTitle}"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,14,0,0" />

                    <TextBlock Text="{Binding ApplicationSubtitle}"
                               Style="{DynamicResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navigatsiya -->
                <ListBox Grid.Row="1"
                         Margin="14,10,14,10"
                         Style="{DynamicResource NavigationListBoxStyle}"
                         ItemContainerStyle="{DynamicResource NavigationItemStyle}"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:NavigationItemViewModel}">
                            <Grid Margin="14,0,10,0" Background="Transparent"
                                  ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="17"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- E'tibor talab qiladigan holat (hozircha faqat yangi versiya).
                                     Ataylab kichik: banner emas, shunchaki sezilib turadigan nuqta. -->
                                <Ellipse Grid.Column="2"
                                         Width="8" Height="8"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentBrush}"
                                         ToolTip="Yangi versiya mavjud"
                                         Visibility="{Binding HasNotification, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Quyi qism: mavzu kaliti, versiya va muallif -->
                <StackPanel Grid.Row="2" Margin="24,8,24,22">
                    <Border Style="{DynamicResource SeparatorLineStyle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE708;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="Qorong'i rejim"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />

                        <ToggleButton Grid.Column="2"
                                      Style="{DynamicResource AppToggleSwitchStyle}"
                                      IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                      ToolTip="Yorug' va qorong'i mavzu o'rtasida almashish"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Button Content="Tizim mavzusiga moslash"
                            Style="{DynamicResource SubtleButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="-12,6,0,0"
                            Command="{Binding UseSystemThemeCommand}" />

                    <Border Style="{DynamicResource SeparatorLineStyle}" Margin="0,14,0,12" />

                    <!-- Versiya va muallif — bosilganda "Dastur haqida" sahifasi ochiladi -->
                    <Button Style="{DynamicResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="Auto"
                            Margin="-12,0,0,0"
                            Padding="12,8"
                            Command="{Binding ShowAboutCommand}"
                            ToolTip="Dastur haqida — muallif va aloqa">
                        <StackPanel>
                            <TextBlock Text="{Binding VersionText}"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       HorizontalAlignment="Left" />

                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="Yaratuvchi:"
                                           Style="{DynamicResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding AuthorText}"
                                           Style="{DynamicResource CaptionTextStyle}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Ishchi hudud ============================ -->
        <Border Grid.Column="1"
                Background="{DynamicResource ContentBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="10,0,0,0">
            <ContentControl Content="{Binding CurrentViewModel}"
                            Focusable="False" />
        </Border>
    </Grid>
</Window>
