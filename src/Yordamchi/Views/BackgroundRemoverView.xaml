<UserControl x:Class="Yordamchi.Views.BackgroundRemoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Yordamchi.Behaviors"
             xmlns:viewModels="clr-namespace:Yordamchi.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1080" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=viewModels:BackgroundRemoverViewModel}">

    <UserControl.Resources>

        <!-- Fayl sudrab kelinganda accent rangga bo'yaladigan tashlash hududi -->
        <Style x:Key="ActiveDropZoneStyle" TargetType="Border"
               BasedOn="{StaticResource DropZoneBorderStyle}">
            <Style.Triggers>
                <Trigger Property="behaviors:FileDrop.IsDragOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            Shaffoflikni ko'rsatuvchi shaxmat taxtasi. Ranglar ataylab qattiq yozilgan:
            "shaffof" belgisi har qanday mavzuda bir xil ko'rinishi kerak, shuning uchun
            yorug'/qorong'i rejimda ham o'qiladigan o'rtacha kulranglar tanlangan.
            Viewport 16x16 (absolyut) — ya'ni katakcha o'lchami rasm o'lchamiga bog'liq emas.
        -->
        <DrawingBrush x:Key="CheckerboardBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#E8E8E8">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C9C9C9">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--
            "Aylantirish" tugmasi. AccentButtonStyle ning shakli qat'iy (ControlCornerRadius),
            shuning uchun bu yerda faqat dumaloq (pill) shakl uchun alohida shablon yozilgan;
            barcha ranglar mavjud mavzu kalitlaridan olinadi.
        -->
        <Style x:Key="ConvertButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <!-- Soya alohida, bo'sh qatlamda: tugmaning o'zida turgan
                                 Effect ClearType ni o'chirib, yozuvni xiralashtirar edi. -->
                            <Border x:Name="ButtonShadow"
                                    Margin="3"
                                    Background="{DynamicResource ShadowCasterBrush}"
                                    CornerRadius="24"
                                    Effect="{DynamicResource CardShadowEffect}"
                                    IsHitTestVisible="False" />

                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="24"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="HoverOverlay" Opacity="0"
                                            Background="{DynamicResource AccentHoverBrush}"
                                            CornerRadius="24" />
                                    <Border x:Name="PressOverlay" Opacity="0"
                                            Background="{DynamicResource AccentPressedBrush}"
                                            CornerRadius="24" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource ControlFillDisabledBrush}" />
                                <!-- O'chirilgan holatda fon yarim shaffof bo'ladi, shuning uchun
                                     soya qatlami butunlay yashiriladi — aks holda qora dog' ko'rinardi. -->
                                <Setter TargetName="ButtonShadow" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0" />
                                <Setter TargetName="PressOverlay" Property="Opacity" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Sarlavha ============================ -->
        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{DynamicResource SubtleButtonStyle}"
                        Content="&#x2039; Orqaga"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        ToolTip="Vositalar ro'yxatiga qaytish"
                        Command="{Binding BackCommand}" />

                <!-- Vositaning o'z rangi: binafsha — AI guruhini bildiradi -->
                <Border Grid.Column="1"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="#8E4EC6"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE91B;"
                               FontFamily="{DynamicResource IconFontFamily}"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding Description}" Style="{DynamicResource SubtitleTextStyle}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Model topilmaganda: sariq ogohlantirish paneli -->
            <!-- Ranglar mavzu kalitlaridan: qattiq yozilgan amber qorong'i fonda
                 loyqa jigarrangga aylanib, ogohlantirish bo'lishdan to'xtar edi. -->
            <Border Margin="0,16,0,0" Padding="16,12"
                    Background="{DynamicResource WarningFillBrush}"
                    BorderBrush="{DynamicResource WarningStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Visibility="{Binding IsModelAvailable, Converter={StaticResource BoolToVisibilityInverted}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE7BA;"
                               FontFamily="{DynamicResource IconFontFamily}"
                               FontSize="18"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AI modeli topilmadi" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ModelPath}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="&quot;Yuklab olish&quot; tugmasini bosing yoki u2net.onnx faylini shu papkaga o'zingiz joylang — dasturni qayta ishga tushirish shart emas."
                                   Style="{DynamicResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Style="{DynamicResource StandardButtonStyle}"
                                Content="Papkani ochish"
                                Command="{Binding OpenModelFolderCommand}" />
                        <Button Style="{DynamicResource AccentButtonStyle}"
                                Content="Yuklab olish"
                                Margin="8,0,0,0"
                                Command="{Binding DownloadModelCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============================ Asosiy qator ============================ -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======== Chap panel: original rasm ======== -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Original rasm"
                               Style="{DynamicResource SectionHeaderTextStyle}" />

                    <Grid Grid.Row="1" Margin="0,14,0,0">

                        <!-- Bo'sh holat: drag & drop hududi -->
                        <Border Style="{StaticResource ActiveDropZoneStyle}"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                behaviors:FileDrop.Command="{Binding DropFilesCommand}"
                                behaviors:FileDrop.Extensions=".jpg,.jpeg,.png,.bmp,.webp"
                                Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibilityInverted}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE91B;"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="44" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="Rasmni shu yerga tashlang"
                                           Style="{DynamicResource SectionHeaderTextStyle}"
                                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock Text="yoki tanlang"
                                           Style="{DynamicResource CaptionTextStyle}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                                <TextBlock Text="JPG, PNG, BMP, WEBP"
                                           Style="{DynamicResource CaptionTextStyle}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <Button Style="{DynamicResource AccentButtonStyle}"
                                        Content="Rasm tanlash"
                                        HorizontalAlignment="Center" Margin="0,18,0,0"
                                        Command="{Binding OpenImageCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Tanlangan rasm (yangi rasmni ustiga tashlab almashtirish mumkin) -->
                        <Grid behaviors:FileDrop.Command="{Binding DropFilesCommand}"
                              behaviors:FileDrop.Extensions=".jpg,.jpeg,.png,.bmp,.webp"
                              Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource ThumbnailBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding SourceImage}"
                                           Stretch="Uniform"
                                           Margin="10"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <Button Style="{DynamicResource IconButtonStyle}"
                                            Content="&#xE711;"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="8"
                                            ToolTip="Rasmni olib tashlash"
                                            Command="{Binding ClearCommand}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="2,10,2,0">
                                <TextBlock Text="{Binding SourceFileName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SourceSizeBytes, Converter={StaticResource FileSize}}"
                                           Style="{DynamicResource CaptionTextStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======== O'rta ustun: amal ======== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="12,0,12,0">

                <!--
                    Progress ring: ikkita ellips — birinchisi statik "yo'l", ikkinchisi esa
                    StrokeDashArray bilan kesilgan yoy. Yoy cheksiz DoubleAnimation orqali
                    1 soniyada bir marta to'liq aylanadi.
                -->
                <Grid Width="64" Height="64" HorizontalAlignment="Center"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="56" Height="56"
                             Stroke="{DynamicResource DividerBrush}"
                             StrokeThickness="4" />

                    <Ellipse x:Name="SpinnerArc"
                             Width="56" Height="56"
                             Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="4"
                             StrokeDashCap="Round"
                             StrokeDashArray="12 32"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:1"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                           Style="{DynamicResource CaptionTextStyle}"
                           HorizontalAlignment="Center" Margin="0,6,0,14"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <Button Style="{StaticResource ConvertButtonStyle}"
                        HorizontalAlignment="Center"
                        ToolTip="Fonni AI yordamida olib tashlash"
                        Command="{Binding RemoveBackgroundCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Aylantirish" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE72A;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="14"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="AI modeli rasmni tahlil qiladi"
                           Style="{DynamicResource CaptionTextStyle}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <!-- ======== O'ng panel: natija ======== -->
            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Natija"
                               Style="{DynamicResource SectionHeaderTextStyle}" />

                    <Grid Grid.Row="1" Margin="0,14,0,0">

                        <!-- Natija bor: shaxmat taxtasi foni ustida shaffof rasm -->
                        <Border Background="{StaticResource CheckerboardBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                ClipToBounds="True"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding ResultImage}"
                                   Stretch="Uniform"
                                   Margin="10"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Natija yo'q -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityInverted}}">
                            <TextBlock Text="&#xE91B;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="44" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="Natija shu yerda ko'rinadi"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ Pastki panel ============================ -->
        <Grid Grid.Row="2" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                       Style="{DynamicResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource AccentButtonStyle}"
                        Margin="0,0,8,0"
                        Command="{Binding SavePngCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="Natijani saqlash (PNG)" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource StandardButtonStyle}"
                        Command="{Binding AddToPdfCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="PDF-ga qo'shish" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================ Band holati (overlay) ============================ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource BusyOverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" Style="{DynamicResource SectionHeaderTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{DynamicResource AppProgressBarStyle}" Margin="0,16,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    <Button Content="Bekor qilish" Style="{DynamicResource StandardButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,18,0,0"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
