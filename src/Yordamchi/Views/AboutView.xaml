<UserControl x:Class="Yordamchi.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Yordamchi.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=viewModels:AboutViewModel}">

    <UserControl.Resources>
        <!-- Komponent holati qatori: yashil "tayyor" yoki sariq "e'tibor bering" nishoni bilan -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,6,12,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource AppScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,26,32,32" MaxWidth="920" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== Sarlavha ==================== -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleTextStyle}" />
                <TextBlock Text="{Binding Description}" Style="{DynamicResource SubtitleTextStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- ==================== Dastur kartochkasi ==================== -->
            <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="28" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Soya alohida qatlamda: belgi saqlaydigan Border ga qo'yilgan Effect
                         ClearType ni o'chirib, ikonkani xiralashtirar edi. -->
                    <Grid Grid.Column="0"
                          Width="72" Height="72"
                          VerticalAlignment="Top">
                        <Border Margin="3"
                                CornerRadius="{DynamicResource LargeCornerRadius}"
                                Background="{DynamicResource ShadowCasterBrush}"
                                Effect="{DynamicResource CardShadowEffect}"
                                IsHitTestVisible="False" />

                        <Border CornerRadius="{DynamicResource LargeCornerRadius}"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="34"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ApplicationName}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <Border Background="{DynamicResource AccentSubtleBrush}"
                                    CornerRadius="{DynamicResource PillCornerRadius}"
                                    Padding="12,4"
                                    Margin="14,4,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding VersionText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Tagline}"
                                   Style="{DynamicResource SubtitleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <Border Style="{DynamicResource SeparatorLineStyle}" Margin="0,20,0,20" />

                        <!-- ============ Muallif ============ -->
                        <TextBlock Text="YARATUVCHI"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="{Binding AuthorName}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="{Binding AuthorRole}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   Margin="0,2,0,0" />

                        <!-- Telegram havolasi -->
                        <Button Style="{DynamicResource StandardButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,16,0,0"
                                Command="{Binding OpenTelegramCommand}"
                                ToolTip="{Binding TelegramLink}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F2;"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Telegram:" Margin="10,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TelegramHandle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding TelegramLink}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   Margin="0,8,0,0" />

                        <TextBlock Text="{Binding CopyrightText}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== Komponentlar holati ==================== -->
            <StackPanel Grid.Row="2" Margin="0,28,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Qo'shimcha komponentlar"
                               Style="{DynamicResource SectionHeaderTextStyle}" />

                    <Button Grid.Column="1" Style="{DynamicResource SubtleButtonStyle}"
                            Content="Qayta tekshirish"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <TextBlock Text="Bu komponentlar ixtiyoriy — ularsiz ham dasturning asosiy vositalari ishlaydi."
                           Style="{DynamicResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />

                <!-- OCR -->
                <Border Style="{DynamicResource CardBorderStyle}" Padding="20,16" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOcrReady}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="OCR til fayllari (Tesseract)" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OcrStatus}"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="Papkani ochish"
                                    Command="{Binding OpenOcrFolderCommand}" Margin="0,0,8,0" />
                            <Button Style="{DynamicResource AccentButtonStyle}" Content="Yuklab olish"
                                    Command="{Binding DownloadOcrLanguagesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- AI modeli -->
                <Border Style="{DynamicResource CardBorderStyle}" Padding="20,16" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiReady}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="AI modeli — fonni olib tashlash (u2net)" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AiStatus}"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="Papkani ochish"
                                    Command="{Binding OpenModelFolderCommand}" Margin="0,0,8,0" />
                            <Button Style="{DynamicResource AccentButtonStyle}" Content="Yuklab olish"
                                    Command="{Binding DownloadAiModelCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dastur yangilanishi -->
                <Border Style="{DynamicResource CardBorderStyle}" Padding="20,16" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
                                    <!-- Yangilanish yo'qligi — muammo emas, shuning uchun yashil -->
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Dastur yangilanishi" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UpdateStatus}"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="Nima o'zgardi"
                                    Command="{Binding ViewReleaseNotesCommand}"
                                    ToolTip="{Binding ReleasesPageUrl}"
                                    Margin="0,0,8,0" />
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="Tekshirish"
                                    Command="{Binding CheckForUpdateCommand}" Margin="0,0,8,0" />
                            <Button Style="{DynamicResource AccentButtonStyle}" Content="Yangilash"
                                    Command="{Binding DownloadAndInstallCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Microsoft Word -->
                <Border Style="{DynamicResource CardBorderStyle}" Padding="20,16" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWordReady}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Microsoft Word (ixtiyoriy)" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WordStatus}"
                                       Style="{DynamicResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== Kutubxonalar ==================== -->
            <StackPanel Grid.Row="3" Margin="0,28,0,0">
                <TextBlock Text="Foydalanilgan ochiq kutubxonalar"
                           Style="{DynamicResource SectionHeaderTextStyle}" />

                <Border Style="{DynamicResource CardBorderStyle}" Padding="8" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Libraries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ComponentInfo}">
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="1" Text="{Binding Purpose}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="12,0" />

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource LayerFillAltBrush}"
                                            CornerRadius="{DynamicResource PillCornerRadius}"
                                            Padding="10,2">
                                        <TextBlock Text="{Binding License}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- ==================== Band qoplamasi ==================== -->
            <Border Grid.Row="0" Grid.RowSpan="5"
                    Background="{DynamicResource BusyOverlayBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Width="380"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyMessage}" Style="{DynamicResource SectionHeaderTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Style="{DynamicResource AppProgressBarStyle}" Margin="0,16,0,0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" />
                        <Button Content="Bekor qilish" Style="{DynamicResource StandardButtonStyle}"
                                HorizontalAlignment="Right" Margin="0,18,0,0"
                                Command="{Binding CancelCommand}" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
