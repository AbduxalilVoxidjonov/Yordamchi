<UserControl x:Class="Yordamchi.Views.RemoteControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Yordamchi.ViewModels"
             xmlns:viewModels="clr-namespace:Yordamchi.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=viewModels:RemoteControlViewModel}">

    <UserControl.Resources>
        <!-- O'rnatish tartibining bitta qadami: raqamli nishon + sarlavha + tavsif -->
        <DataTemplate x:Key="InstallStepTemplate" DataType="{x:Type models:InstallStep}">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="30" Height="30"
                        CornerRadius="15"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding Number}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource TextOnAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{DynamicResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer Style="{DynamicResource AppScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,26,32,32" MaxWidth="920" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ==================== Sarlavha ==================== -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding Description}" Style="{DynamicResource SubtitleTextStyle}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <!-- ==================== Ruxsat haqida ogohlantirish ==================== -->
                <Border Grid.Row="1"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="16,14"
                        Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE946;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,1,12,0" />

                        <TextBlock Grid.Column="1"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Masofaviy boshqaruvni faqat o'zingiz administratsiya qiladigan kompyuterlarga (sinf, laboratoriya, ofis) va foydalanuvchilar xabardor holatda o'rnating. Agent maqsadli kompyuterda ko'rinadigan belgi qoldiradi — kuzatuv yashirin emas." />
                    </Grid>
                </Border>

                <!-- ==================== Agentni yuklab olish ==================== -->
                <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Agent (server) faylini yuklab olish"
                                   Style="{DynamicResource SectionHeaderTextStyle}" />

                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="Agent fayli GitHub relizidan yuklab olinadi. Manzil hali sozlanmagan bo'lsa, real havolani quyidagi maydonga kiriting. Fayl faqat yuklab olinadi — dastur uni ishga tushirmaydi." />

                        <TextBlock Text="Yuklab olish manzili (GitHub, https)"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   Margin="0,16,0,6" />

                        <TextBox Style="{DynamicResource AppTextBoxStyle}"
                                 Text="{Binding AgentDownloadUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{DynamicResource MonospaceFontFamily}"
                                 TextWrapping="Wrap"
                                 SpellCheck.IsEnabled="False" />

                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{Binding ExampleDownloadUrl, StringFormat='Namuna: {0}'}" />

                        <TextBlock Text="{Binding AgentStatus}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{DynamicResource AccentButtonStyle}"
                                    MinWidth="160"
                                    Command="{Binding DownloadAgentCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFontFamily}"
                                               FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Yuklab olish" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource StandardButtonStyle}"
                                    Content="Papkani ochish"
                                    Margin="10,0,0,0"
                                    Command="{Binding OpenDownloadFolderCommand}" />

                            <Button Style="{DynamicResource SubtleButtonStyle}"
                                    Content="Fayl yo'lini nusxa olish"
                                    Margin="6,0,0,0"
                                    Command="{Binding CopyAgentPathCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ==================== O'rnatish tartibi ==================== -->
                <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Maqsadli kompyuterga o'rnatish tartibi"
                                   Style="{DynamicResource SectionHeaderTextStyle}"
                                   Margin="0,0,0,16" />

                        <ItemsControl ItemsSource="{Binding InstallSteps}"
                                      ItemTemplate="{StaticResource InstallStepTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ============================ Band holati (overlay) ============================ -->
        <Border Background="{DynamicResource BusyOverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" Style="{DynamicResource SectionHeaderTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{DynamicResource AppProgressBarStyle}" Margin="0,16,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    <Button Content="Bekor qilish" Style="{DynamicResource StandardButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,18,0,0"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
