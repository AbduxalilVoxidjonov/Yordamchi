<!--
    Controls.xaml - Fluent (Windows 11) control styles, templates, effects and durations for Yordamchi.
    Every color comes from the swappable palette dictionaries via {DynamicResource ...} so that
    switching MergedDictionaries[0] between Colors.Light.xaml / Colors.Dark.xaml repaints live.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================================
         1. SHARED PRIMITIVES
         ================================================================================== -->

    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Duration is a WPF (System.Windows) type: no extra xmlns needed. -->
    <Duration x:Key="FastDuration">0:0:0.12</Duration>
    <Duration x:Key="NormalDuration">0:0:0.2</Duration>
    <Duration x:Key="SlowDuration">0:0:0.35</Duration>

    <CubicEase x:Key="StandardEase" EasingMode="EaseOut" />
    <QuarticEase x:Key="EmphasizedEase" EasingMode="EaseOut" />

    <!-- Effects: Color is hard-coded black. A DropShadowEffect declared as a standalone
         resource has no FrameworkElement context, so {DynamicResource ShadowColor} would
         not resolve reliably; per-theme depth is expressed through Opacity instead.

         RenderingBias MUHIM: "Performance" da WPF effekt kiritmasini — ya'ni butun
         element mazmunini — BlurRadius ga mutanosib ravishda kichraytirilgan oraliq
         teksturaga chizadi. BlurRadius 22 bo'lganda matn sezilarli xira ko'rinadi
         (ayniqsa qorong'i mavzuda). Shu sababli hamma joyda "Quality".

         Bundan tashqari, soya HECH QACHON matn saqlaydigan Border ga qo'yilmasin —
         u ClearType ni o'chiradi. Buning o'rniga mazmun ostiga alohida, bo'sh
         "soya qatlami" Border qo'yiladi (DashboardView / ToolWorkspaceView ga qarang). -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="10" ShadowDepth="2" Direction="270"
                      Opacity="0.16" Color="#000000" RenderingBias="Quality" />
    <DropShadowEffect x:Key="HoverShadowEffect"
                      BlurRadius="16" ShadowDepth="4" Direction="270"
                      Opacity="0.26" Color="#000000" RenderingBias="Quality" />
    <DropShadowEffect x:Key="FlyoutShadowEffect"
                      BlurRadius="20" ShadowDepth="4" Direction="270"
                      Opacity="0.24" Color="#000000" RenderingBias="Quality" />

    <!-- ==================================================================================
         2. TYPOGRAPHY
         ================================================================================== -->

