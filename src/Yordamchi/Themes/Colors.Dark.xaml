<!--
    Colors.Dark.xaml - Windows 11 Fluent DARK palette. Colors + brushes ONLY (no styles).
    Must expose exactly the same x:Key set as Colors.Light.xaml: ThemeService hot-swaps
    Application.Current.Resources.MergedDictionaries[0] between the two at runtime.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Raw colors ===== -->
    <Color x:Key="ShadowColor">#FF000000</Color>
    <Color x:Key="AccentColor">#FF60CDFF</Color>
    <Color x:Key="AppBackgroundColor">#FF202020</Color>
    <Color x:Key="LayerFillColor">#FF2C2C2C</Color>

    <!-- ===== Surfaces ===== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#CC1C1C1C" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FF272727" />
    <SolidColorBrush x:Key="LayerFillBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="LayerFillAltBrush" Color="#FF333333" />

    <!-- Soya qatlamining to'ldiruvchisi. Bu Border kartochka ORQASIDA turadi va
         to'liq berkitiladi — ko'rinadigan yagona qismi uning tashqi soyasi. -->
    <SolidColorBrush x:Key="ShadowCasterBrush" Color="#FF000000" />

    <!-- ===== Strokes / dividers (alpha-composited so cards read correctly over Mica) ===== -->
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="StrokeDefaultBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5DFFFFFF" />
    <!-- Windows 11 dark-accent convention: near-black text on the light accent fill. -->
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FF001322" />

    <!-- ===== Accent ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF7AD6FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF4FB8E8" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2660CDFF" />

    <!-- ===== Control fills ===== -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#15FFFFFF" />
    <!-- Ochiq ComboBox ham shu kalitni ishlatadi: u tinch holatdan kuchliroq
         bo'lmasa, ochilgan ro'yxat o'chirilgan boshqaruvdek ko'rinadi. -->
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#18FFFFFF" />

    <!-- ===== Subtle (transparent-until-hover) fills ===== -->
    <!-- Bosilgan holat hover dan KUCHLIROQ bo'lishi shart: aks holda tugmani
         bosish uni so'nadi deb his qilinadi (yorug' mavzudagi tartib bilan bir xil). -->
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#1AFFFFFF" />

    <!-- ===== Semantic ===== -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFFFB2BA" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFE88794" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F" />

    <!-- Ogohlantirish. Yorug' mavzudagi to'q sariq qorong'i fonda loyqa jigarrangga
         aylanadi, shuning uchun bu yerda yorqinroq (och) sariq olingan. -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFCC934" />
    <SolidColorBrush x:Key="WarningFillBrush" Color="#38FFC83D" />
    <SolidColorBrush x:Key="WarningStrokeBrush" Color="#8CFFC83D" />

    <!-- ===== Page thumbnails / drag &amp; drop ===== -->
    <!-- ThumbnailBackgroundBrush stays near-white in BOTH themes: PDF pages are white paper. -->
    <SolidColorBrush x:Key="ThumbnailBackgroundBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="SelectionStrokeBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="InsertionIndicatorBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="DropZoneStrokeBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="DropZoneFillBrush" Color="#0AFFFFFF" />

    <!-- Eskiz USTIDA turadigan qoplama nishonlari va shisha tugmalari. Ular oq
         "qog'oz" ustida yotgani uchun ikkala mavzuda ham to'q qoladi; faqat
         xavfli (o'chirish) tugmasining hover rangi mavzuga ergashadi. -->
    <SolidColorBrush x:Key="ThumbnailOverlayFillBrush" Color="#BF000000" />
    <SolidColorBrush x:Key="ThumbnailOverlayHoverFillBrush" Color="#E0000000" />
    <SolidColorBrush x:Key="ThumbnailOverlayForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ThumbnailOverlayDangerFillBrush" Color="#E6FF99A4" />
    <!-- Och pushti to'ldirish ustida oq belgi ko'rinmaydi — deyarli qora olamiz. -->
    <SolidColorBrush x:Key="ThumbnailOverlayDangerForegroundBrush" Color="#FF2A0007" />

    <!-- ===== Scrollbars ===== -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#8CFFFFFF" />

    <!-- ===== Overlays ===== -->
    <!-- ~70% of the window background. -->
    <SolidColorBrush x:Key="BusyOverlayBrush" Color="#B3202020" />
    <!-- Hover scrim over a page thumbnail; identical in both themes (it sits on the image). -->
    <LinearGradientBrush x:Key="ScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0.0" Color="#00000000" />
        <GradientStop Offset="0.45" Color="#26000000" />
        <GradientStop Offset="1.0" Color="#99000000" />
    </LinearGradientBrush>

</ResourceDictionary>
