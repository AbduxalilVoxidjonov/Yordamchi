<Application x:Class="Yordamchi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Yordamchi.Converters"
             xmlns:viewModels="clr-namespace:Yordamchi.ViewModels"
             xmlns:views="clr-namespace:Yordamchi.Views"
             DispatcherUnhandledException="OnDispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    0-indeks — ranglar lug'ati; uni ish vaqtida ThemeService ALMASHTIRADI.
                    Controls.xaml ichidagi hamma narsa bu ranglarga DynamicResource orqali
                    murojaat qiladi, aynan shu almashtirishni jonli UI da ishlatadi.
                -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />

                <!-- Vosita sozlamalari panelining shakllari -->
                <ResourceDictionary Source="Views/ToolOptionTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ==================== Konverterlar ==================== -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityInverted" Invert="True" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVisibilityInverted" Invert="True" />
            <converters:PageRotationToTransformConverter x:Key="RotationToTransform" />
            <converters:PageRotationToAngleConverter x:Key="RotationToAngle" />
            <converters:EnumEqualsConverter x:Key="EnumEquals" />
            <converters:FileSizeConverter x:Key="FileSize" />
            <converters:MathMultiplyConverter x:Key="Multiply" />
            <converters:BooleanToOpacityConverter x:Key="BoolToOpacity" />

            <!-- ==================== ViewModel -> View ==================== -->
            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ToolWorkspaceViewModel}">
                <views:ToolWorkspaceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:BackgroundRemoverViewModel}">
                <views:BackgroundRemoverView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ScreenRecorderViewModel}">
                <views:ScreenRecorderView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
