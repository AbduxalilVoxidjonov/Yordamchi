<?xml version="1.0" encoding="utf-8"?>
<!--
    Yordamchi MSI.

    O'zi-yetarli (self-contained) publish natijasini — dastur + shaxsiy .NET runtime +
    pdfium/Skia/Tesseract/ONNX native kutubxonalari — "Program Files" ga o'rnatadi,
    Start menyu va ish stolida yorliq yaratadi hamda "Dasturlar va komponentlar"
    ro'yxatiga to'g'ri yozuv qo'shadi.

    build-installer.ps1 tomonidan quriladi; `-d PublishDir=<papka>` va `-arch x64` kutadi.

    Muallif: Abduxalil Voxidjonov — https://t.me/abduxalilvoxidjonov
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Yordamchi"
           Manufacturer="Abduxalil Voxidjonov"
           Version="$(var.ProductVersion)"
           UpgradeCode="5ACEDECA-2D08-49FE-9CE6-D6B41801065F"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <!--
        UpgradeCode ATAYLAB O'ZGARMAYDI. Mahsulot nomi "PDF Suite" dan "Yordamchi" ga
        o'zgardi va o'rnatish papkasi ham boshqa, lekin UpgradeCode bir xil qolgani uchun
        MSI eski o'rnatmani avval OLIB TASHLAYDI, so'ng yangisini qo'yadi — foydalanuvchida
        ikkita alohida dastur bo'lib qolmaydi.
        AllowSameVersionUpgrades — bir xil versiyani qayta o'rnatishga ham ruxsat beradi.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Kompyuterda Yordamchi dasturining yangiroq versiyasi o'rnatilgan. Avval uni olib tashlang, so'ng bu versiyani o'rnating." />

    <!-- LZX:high ~168 MB yukni taxminan uchdan biriga tushiradi. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="YordamchiIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="YordamchiIcon" />
    <Property Id="ARPHELPLINK" Value="https://t.me/abduxalilvoxidjonov" />
    <Property Id="ARPURLINFOABOUT" Value="https://t.me/abduxalilvoxidjonov" />
    <Property Id="ARPCONTACT" Value="Abduxalil Voxidjonov" />
    <Property Id="ARPCOMMENTS" Value="Yordamchi — Windows uchun 17 ta PDF vositasi va ekran yozuvi. © 2026 Abduxalil Voxidjonov" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Litsenziya -> o'rnatish papkasi -> jarayon -> yakun. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />

    <Feature Id="Main" Title="Yordamchi" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <!-- ================= Papkalar ================= -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Yordamchi" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationMenuFolder" Name="Yordamchi" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- ================= Yuk (payload) =================
       <Files> butun publish daraxtini avtomatik yig'adi va papka tuzilmasini saqlaydi,
       shuning uchun yangi runtime fayllarini qo'lda sanab chiqish kerak emas.
  -->
  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <!-- ================= Yorliqlar ================= -->
  <Fragment>
    <Component Id="StartMenuShortcut"
               Directory="ApplicationMenuFolder"
               Guid="8FB0CD15-96F7-4AC7-8302-605A245CF64A">
      <Shortcut Id="StartMenuYordamchi"
                Name="Yordamchi"
                Description="PDF vositalari, OCR, AI va ekran yozuvi"
                Target="[INSTALLFOLDER]Yordamchi.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="YordamchiIcon" />
      <RemoveFolder Id="RemoveApplicationMenuFolder" Directory="ApplicationMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\Yordamchi" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut"
               Directory="DesktopFolder"
               Guid="02852839-B7D9-42F2-86BC-BDB6DB48AFA9">
      <Shortcut Id="DesktopYordamchi"
                Name="Yordamchi"
                Description="PDF vositalari, OCR, AI va ekran yozuvi"
                Target="[INSTALLFOLDER]Yordamchi.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="YordamchiIcon" />
      <RegistryValue Root="HKLM" Key="Software\Yordamchi" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
